# Copy to .env and fill in. docker compose reads .env automatically.

# Folder with the client files (mounted read-only into the containers)
DATA_DIR=./data

# Client systems. host.docker.internal resolves to the Docker host (see extra_hosts in docker-compose.yml)
PAYROLL_URL=http://host.docker.internal:8081
DISPATCH_URL=http://host.docker.internal:8082
FINANCE_URL=http://host.docker.internal:8083

# Credentials for the client systems. docker-compose.yml defaults them to the
# assessment values from each API.md; set them here only to override.
# PAYROLL_API_KEY=
# DISPATCH_CLIENT_ID=
# DISPATCH_CLIENT_SECRET=
# FINANCE_USER=
# FINANCE_PASSWORD=

# Model provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# true = decide every absence but never write to payroll
PAYROLL_DRY_RUN=false

# Reporting period (YYYY-MM). Leave unset to infer it from the time clock data.
# PERIOD=2026-10
